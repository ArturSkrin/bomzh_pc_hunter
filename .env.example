# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM через LiteLLM: модель в формате провайдер/модель, ключ провайдера отдельной переменной
LLM_MODEL=anthropic/claude-haiku-5-5
ANTHROPIC_API_KEY=

# Сборщик
POLL_INTERVAL_MIN=12
REQUEST_DELAY_SEC=3
DB_PATH=data/baraholka.db

# Жёсткий потолок цены в RON — агент не может предложить больше
MAX_PRICE_RON=1500
