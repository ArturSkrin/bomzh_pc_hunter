# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM через LiteLLM: модель в формате провайдер/модель, ключ провайдера отдельной переменной
LLM_MODEL=openai/gpt-5-mini
OPENAI_API_KEY=

# Сборщик
REQUEST_DELAY_SEC=3
DB_PATH=data/baraholka.db

# Веб-морда, только на 127.0.0.1. Потолок цены, интервал, запросы и промпты — настраиваются в ней
WEB_PORT=8080
